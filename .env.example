# 复制为 .env，密钥只留本机。现有 .env 不随项目包导出。
# ElevenLabs：TTS；中文讲解和挑战免费额度检查需 User/account 读取。
# 自主挑战另外需要文件转写 STT 权限；实时语音聊天仍停用。
SPEECH_OUTPUT_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE_ID_ZH=
ELEVENLABS_VOICE_ID_EN=
ELEVENLABS_TTS_MODEL=eleven_v4_turbo
# 保守预算估算，不是云平台报价或余额；实际免费护栏在服务端校验。
ELEVENLABS_TTS_CNY_PER_MILLION=400
# 留空使用项目锁定的官方 CLI 和账号默认模型；登录由官方客户端管理。
CODEX_BIN=
CODEX_DIALOGUE_MODEL=
PORT=8787
# 实时语音服务保持停用，不需要额外供应商配置。
